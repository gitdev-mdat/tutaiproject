                {
                  "id": "node-sg3wg6atb",
                  "type": "CONCEPT",
                  "title": "Cực trị của hàm số",
                  "slug": "cuc-tri-cua-ham-so",
                  "primaryDomainId": "node-nrm3k7taj",
                  "shortDescription": "Cực trị của hàm số gồm cực đại và cực tiểu địa phương, phân biệt giữa điểm cực trị, giá trị cực trị và điểm biểu diễn tương ứng trên đồ thị.",
                  "detailedDescription": "Nếu x₀ là điểm cực đại hoặc cực tiểu địa phương thì x₀ là hoành độ điểm cực trị, f(x₀) là giá trị cực trị, còn (x₀, f(x₀)) là điểm cực trị trên đồ thị. Với hàm số khả vi ở hai phía của x₀, việc f′ đổi dấu từ dương sang âm khi qua x₀ là điều kiện đủ để có cực đại, còn đổi dấu từ âm sang dương là điều kiện đủ để có cực tiểu; riêng điều kiện f′(x₀) = 0 không đủ để kết luận có cực trị.",
                  "aliases": [],
                  "order": 4,
                  "status": "PUBLISHED",
                  "provenance": {
