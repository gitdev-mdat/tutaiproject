                {
                  "id": "node-s0f2jitge",
                  "type": "CONCEPT",
                  "title": "Tính đơn điệu của hàm số",
                  "slug": "tinh-don-dieu-cua-ham-so",
                  "primaryDomainId": "node-nrm3k7taj",
                  "shortDescription": "Tính đơn điệu mô tả chiều biến thiên của hàm số trên một khoảng, gồm đồng biến và nghịch biến. Khái niệm có thể được nhận biết từ định nghĩa, đồ thị hoặc dấu của đạo hàm.",
                  "detailedDescription": "Trên một khoảng I, hàm số f đồng biến khi x₁ < x₂ kéo theo f(x₁) < f(x₂), và nghịch biến khi x₁ < x₂ kéo theo f(x₁) > f(x₂). Trên đồ thị, điều này tương ứng với đường cong đi lên hoặc đi xuống khi quan sát từ trái sang phải. Nếu f khả vi trên I, dấu của đạo hàm cung cấp điều kiện đủ quen thuộc để xác định các khoảng đơn điệu: f′(x) > 0 cho đồng biến và f′(x) < 0 cho nghịch biến trên khoảng đang xét.",
                  "aliases": [],
                  "order": 3,
                  "status": "PUBLISHED",
                  "provenance": {
                    "sourceType": "IMPORT",
                    "sourceId": "a3c9c76c-834c-454e-867b-fec39c0e8403",
